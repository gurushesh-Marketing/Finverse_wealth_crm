# Copy to .env and fill in local values. .env is gitignored — never commit it.
# Placeholders only in this file.
# The API connects privately to the PostgreSQL service inside self-hosted Supabase.
# Use a direct/session connection, not transaction pooling (the CRM uses advisory locks).
# Keep real passwords only in the ignored .env file.
DATABASE_URL=postgresql://finverse_app:replace-with-local-password@localhost:5434/postgres
TEST_DATABASE_URL=postgresql://finverse_app:replace-with-test-password@localhost:5434/finverse_test
# Staging only: private direct/session database connection inside a self-hosted Supabase stack.
# Set locally for `pnpm db:supabase:verify`; never expose in VITE_ variables.
# SUPABASE_STAGING_DATABASE_URL=postgresql://crm_reader:replace-with-staging-password@127.0.0.1:5432/postgres
SESSION_SECRET=replace-with-long-random-string
API_PORT=4000
# Demo login directory (synthetic accounts). Dev shows it automatically.
# Leave both unset in production: panel excluded from the build, @finverse.demo logins rejected.
# VITE_DEMO_ACCESS=true
# DEMO_ACCESS_ENABLED=true

