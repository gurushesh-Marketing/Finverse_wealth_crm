{
  "name": "finverse-crm-v2",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @finverse/api --filter @finverse/web dev",
    "dev:api": "pnpm --filter @finverse/api dev",
    "dev:web": "pnpm --filter @finverse/web dev",
    "build": "pnpm --filter @finverse/contracts build && pnpm --filter @finverse/api build && pnpm --filter @finverse/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @finverse/api test && pnpm --filter @finverse/web test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
